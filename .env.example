# Database
DATABASE_URL=postgresql://user:password@localhost:5432/notnow_stage2

# Server
PORT=3000
NODE_ENV=development

# Meta WhatsApp Business API (Cycle 3)
META_API_TOKEN=your_meta_token_here
# Signs incoming webhooks (App Settings → Basic → App secret). 32 hex chars.
META_APP_SECRET=your_meta_app_secret_here
# Answers Meta's GET verification challenge. Any string you choose.
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_BUSINESS_ACCOUNT_ID=your_business_account_id_here

# Must match the template approved in Meta exactly.
META_TEMPLATE_NAME=scheduled_message_reminder
META_TEMPLATE_LANGUAGE=he

# Claude LLM (Cycle 3)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Whisper transcription for voice notes. Optional — without it the bot asks
# the sender to write instead of failing.
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_MODEL=whisper-1

# Stripe (Cycle 4)
STRIPE_API_KEY=your_stripe_api_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# App URLs
APP_URL=http://localhost:3000
